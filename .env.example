BITUNIX_API_KEY=
BITUNIX_API_SECRET=

GUARDIAN_MODE=SHADOW
GUARDIAN_ENABLE_COMMANDS=false
GUARDIAN_ALLOW_PLACE_SL=false
GUARDIAN_ALLOW_FLASH_CLOSE=false
GUARDIAN_ARM_PHRASE=

GUARDIAN_SYMBOLS=BTCUSDT

GUARDIAN_WARNING_ATR=3.0
GUARDIAN_DANGER_ATR=2.0
GUARDIAN_EMERGENCY_ATR=1.25

GUARDIAN_WARNING_PCT=0.03
GUARDIAN_DANGER_PCT=0.02
GUARDIAN_EMERGENCY_PCT=0.0125

GUARDIAN_CATASTROPHIC_BUFFER_ATR=0.75
GUARDIAN_CATASTROPHIC_BUFFER_PCT=0.005

GUARDIAN_LOCKOUT_MINUTES=120
GUARDIAN_STATE_DIR=/data/guardian

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALERT_CHAT_ID=

# Separate public-market observer; no account credentials required.
EARLY_BREAKOUT_STATE_DIR=/data/early_breakout
COPILOT_AUDIT_STATE_DIR=/data/copilot_audit

# V7 live_auto.py passive public-market observer; never grants trade authority.
MLRSI_OBSERVER_ENABLED=true
MLRSI_TELEGRAM_ALERTS=true
MLRSI_APPROACHING_ENABLED=true
MLRSI_APPROACH_DISTANCE=1.0
MLRSI_APPROACH_REARM_DISTANCE=1.5
MLRSI_PROVISIONAL_ALERTS=true
