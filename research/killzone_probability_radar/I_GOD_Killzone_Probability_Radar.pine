//@version=6
indicator("I-GOD Killzone Probability Radar", shorttitle="I-GOD KZ Radar", overlay=true, max_bars_back=500)
// Independent research indicator. Original Killzone V3.7 Lite is not changed.
// BINANCE:BTCUSDT SPOT, standard candles, H1 only. No orders, alerts or webhooks.
const string TZ = "America/New_York"
const int HOUR = 3600000
const int MINUTE = 60000
// Generated publication gate. NOT an input: historical fit alone cannot enable probabilities.
const bool MODEL_VALIDATED = false
const string MODEL_VERSION = "KZR_V1_b3e7f819bb07"
const string MODEL_STATUS = "NO VALIDADO"
bool hideOutside = input.bool(true, "Ocultar fuera de 05:00-06:00 Nueva York")
bool logRealtime = input.bool(true, "Pine Logs: ultimo minuto real disponible (sin alertas)")
string panelCorner = input.string("Arriba derecha", "Panel", options=["Arriba derecha", "Arriba izquierda", "Abajo derecha", "Abajo izquierda"])
string panelPosition = switch panelCorner
    "Arriba izquierda" => position.top_left
    "Abajo derecha" => position.bottom_right
    "Abajo izquierda" => position.bottom_left
    => position.top_right

f_predict(array<float> x) =>
    float z0 = -0.24125098851797655
    float z1 = -0.31658513850976705
    float z2 = 0.28869248836745603
    float v0 = math.max(-8.0, math.min(8.0, (array.get(x, 0) - (0.49166666666666664)) / 0.28863503804144286))
    z0 += v0 * (0.0066460501424100409)
    z1 += v0 * (0.0040037061965935462)
    z2 += v0 * (-0.010649754149043221)
    float v1 = math.max(-8.0, math.min(8.0, (array.get(x, 1) - (0.50587619582349208)) / 0.25527170395620385))
    z0 += v1 * (0.10734494096218189)
    z1 += v1 * (-0.17225573660554255)
    z2 += v1 * (0.0649108413323366)
    float v2 = math.max(-8.0, math.min(8.0, (array.get(x, 2) - (-0.019836497772225264)) / 0.73495184746819064))
    z0 += v2 * (0.20940474648144261)
    z1 += v2 * (-0.18618570479183089)
    z2 += v2 * (-0.023219043591792637)
    float v3 = math.max(-8.0, math.min(8.0, (array.get(x, 3) - (0.99030110935634641)) / 0.79482928025338551))
    z0 += v3 * (0.0031743685918797838)
    z1 += v3 * (0.052017684662993849)
    z2 += v3 * (-0.055192058701302033)
    float v4 = math.max(-8.0, math.min(8.0, (array.get(x, 4) - (-0.016076287777338893)) / 0.45849516546694974))
    z0 += v4 * (0.078085199825161891)
    z1 += v4 * (-0.046092671082653219)
    z2 += v4 * (-0.03199253147722466)
    float v5 = math.max(-8.0, math.min(8.0, (array.get(x, 5) - (2.7803023377266323)) / 1.2410047216905531))
    z0 += v5 * (-0.26578737090341564)
    z1 += v5 * (-0.14756398425568887)
    z2 += v5 * (0.4133327761278639)
    float v6 = math.max(-8.0, math.min(8.0, (array.get(x, 13) - (-0.0066951071934459863)) / 0.61538334347545753))
    z0 += v6 * (0.1424373118428022)
    z1 += v6 * (-0.1318626099318857)
    z2 += v6 * (-0.010574700150381)
    float largest = math.max(z0, math.max(z1, z2))
    float e0 = math.exp(z0 - largest)
    float e1 = math.exp(z1 - largest)
    float e2 = math.exp(z2 - largest)
    float total = e0 + e1 + e2
    [e0 / total, e1 / total, e2 / total]

f_projection(float ah, float al, float lh, float ll) =>
    float amplitude = math.max(ah, lh) - math.min(al, ll)
    float topHeight = ah <= lh ? ah - al : lh - ll
    float bottomHeight = al >= ll ? ah - al : lh - ll
    [math.min(ah, lh) - topHeight * 0.03 + amplitude, math.max(al, ll) + bottomHeight * 0.03 - amplitude]

// Public H1 formulas: only [1] values feed the radar, never this open H1's final OHLC.
// A feed gap starts a new indicator segment, matching the offline warmup policy.
bool resetMath = na(time[1]) or time - time[1] != HOUR
var int mathBars = 0
mathBars := resetMath ? 1 : mathBars + 1
f_segmentRma(float value, int length, bool reset) =>
    var float last = na
    var float seed = 0.0
    var int count = 0
    if reset or na(value)
        last := na
        seed := 0.0
        count := 0
    if not na(value)
        if na(last)
            seed += value
            count += 1
            if count == length
                last := seed / length
        else
            last := (last * (length - 1) + value) / length
    last
float atr14 = f_segmentRma(resetMath ? high - low : ta.tr(true), 14, resetMath)
float upMove = ta.change(high)
float downMove = -ta.change(low)
float plusDM = resetMath ? na : upMove > downMove and upMove > 0 ? upMove : 0.0
float minusDM = resetMath ? na : downMove > upMove and downMove > 0 ? downMove : 0.0
float plusDI = 100 * f_segmentRma(plusDM, 14, resetMath) / atr14
float minusDI = 100 * f_segmentRma(minusDM, 14, resetMath) / atr14
float dx = plusDI + minusDI == 0 ? 0.0 : 100 * math.abs(plusDI - minusDI) / (plusDI + minusDI)
float adx14 = f_segmentRma(dx, 14, resetMath)
float rawAO = ta.sma(hl2, 5) - ta.sma(hl2, 34)
float ao = mathBars >= 34 ? rawAO : na
float width = 4 * ta.stdev(close, 7) / ta.sma(close, 7)
float bbwp = 0.0
bool rankComplete = mathBars >= 107 and not na(width)
for j = 1 to 100
    rankComplete := rankComplete and not na(width[j])
    bbwp += width[j] < width ? 1.0 : 0.0
bbwp := rankComplete ? bbwp : na
[change4h, available4h] = request.security(syminfo.tickerid, "240", [close[1] - close[2], time_close[1]], lookahead=barmerge.lookahead_on)
[mt, mcTime, mh, ml, mclose] = request.security_lower_tf(syminfo.tickerid, "1", [time, time_close, high, low, close], ignore_invalid_timeframe=true, calc_bars_count=100000)

int localHour = hour(time, TZ)
bool identityOK = timeframe.in_seconds() == 3600 and syminfo.tickerid == "BINANCE:BTCUSDT" and chart.is_standard
bool radarHour = identityOK and localHour == 5
var float aHigh = na
var float aLow = na
var float aOpen = na
var float aClose = na
var int aCount = 0
var int aLast = na
var float lHigh = na
var float lLow = na
var float lOpen = na
var float lClose = na
var int lCount = 0
var int lLast = na
var bool chainOK = false

// varip retains only the latest observed panel/log watermark across realtime H1 ticks.
// It is NOT durable storage and does not survive reload; capture Pine Logs externally.
varip int lastAvailable = na
varip int lastEmitted = na
varip int lastMinute = na
varip bool lastDataOK = false
varip float lastUpper = na
varip float lastLower = na
varip float lastNeither = na
varip int closedMinutes = na

if radarHour
    // At execution of historical 05 H1, session vars still contain only 02/03/04.
    bool sessionsOK = chainOK and aCount == 4 and lCount == 3 and lLast == time - HOUR and aLast < time and available4h <= time
    bool inputsOK = sessionsOK and not na(atr14[1]) and atr14[1] > 0 and aHigh > aLow
    float partialHigh = lHigh
    float partialLow = lLow
    float price = lClose
    int count = 0
    bool prefixOK = true
    int n = array.size(mt)
    if n > 0
        for i = 0 to n - 1
            int t = array.get(mt, i)
            int tc = array.get(mcTime, i)
            // No 06:00 forecast; no open minute; historical cutoff is this H1 end.
            int cutoff = barstate.isrealtime ? timenow : time_close
            if tc < time_close and tc <= cutoff
                prefixOK := prefixOK and t == time + count * MINUTE and tc == t + MINUTE
                if prefixOK
                    partialHigh := math.max(partialHigh, array.get(mh, i))
                    partialLow := math.min(partialLow, array.get(ml, i))
                    price := array.get(mclose, i)
                    count += 1
    int knownAt = time + count * MINUTE
    int expected = barstate.isrealtime ? math.min(59, math.max(0, int(math.floor((timenow - time) / MINUTE)))) : 59
    float ahWidth = aHigh - aLow
    float combinedHigh = math.max(aHigh, partialHigh)
    float combinedLow = math.min(aLow, partialLow)
    array<float> x = array.from(count / 60.0, (price - combinedLow) / (combinedHigh - combinedLow), (price - lOpen) / ahWidth, (partialHigh - partialLow) / ahWidth, (aClose - aOpen) / ahWidth, (combinedHigh - combinedLow) / atr14[1], ao[1] / atr14[1], (ao[1] - ao[2]) / atr14[1], adx14[1] / 100.0, (adx14[1] - adx14[2]) / 100.0, (plusDI[1] - minusDI[1]) / 100.0, bbwp[1] / 100.0, (bbwp[1] - bbwp[2]) / 100.0, change4h / ahWidth)
    bool finiteInputs = true
    for v in x
        finiteInputs := finiteInputs and not na(v)
    bool valid = inputsOK and prefixOK and finiteInputs and count <= 59
    if valid and (na(lastAvailable) or knownAt >= lastAvailable)
        [pUpper, pLower, pNeither] = f_predict(x)
        lastAvailable := knownAt
        lastMinute := count
        lastDataOK := count == expected
        closedMinutes := count
        lastUpper := MODEL_VALIDATED and lastDataOK ? pUpper : na
        lastLower := MODEL_VALIDATED and lastDataOK ? pLower : na
        lastNeither := MODEL_VALIDATED and lastDataOK ? pNeither : na
        // Only the latest available record is emitted; no historical minute replay as live.
        if barstate.isrealtime and logRealtime and lastDataOK and (na(lastEmitted) or knownAt > lastEmitted)
            string probabilities = MODEL_VALIDATED ? ",\"probabilities\":[" + str.tostring(pUpper, "#.############") + "," + str.tostring(pLower, "#.############") + "," + str.tostring(pNeither, "#.############") + "]" : ",\"probabilities\":null"
            string vector = ""
            for v in x
                vector += (str.length(vector) > 0 ? "," : "") + str.tostring(v, "#.############")
            string payload = "IGOD_KILLZONE_RADAR_V1={\"version\":\"" + MODEL_VERSION + "\",\"available_at\":" + str.tostring(knownAt) + ",\"emitted_at\":" + str.tostring(timenow) + ",\"minute\":" + str.tostring(count) + ",\"status\":\"" + MODEL_STATUS + "\",\"features\":[" + vector + "]" + probabilities + "}"
            log.info("{0}", payload)
            lastEmitted := knownAt
    else
        lastDataOK := false

// Commit CLOSED H1 state only AFTER the forecast block; critical anti-leakage ordering.
if identityOK and barstate.isconfirmed
    if localHour == 20
        aHigh := high
        aLow := low
        aOpen := open
        aClose := close
        aCount := 1
        aLast := time
        lCount := 0
        lHigh := na
        lLow := na
        chainOK := true
    else
        if not na(aLast) and time - time[1] != HOUR
            chainOK := false
        if localHour >= 21 and localHour <= 23
            aHigh := math.max(aHigh, high)
            aLow := math.min(aLow, low)
            aClose := close
            aCount += 1
            aLast := time
        if localHour >= 2 and localHour <= 5 and aCount == 4
            if localHour == 2
                lHigh := high
                lLow := low
                lOpen := open
                lCount := 1
            else
                lHigh := math.max(lHigh, high)
                lLow := math.min(lLow, low)
                lCount += 1
            lClose := close
            lLast := time

var table panel = table.new(position.top_right, 2, 12, bgcolor=color.rgb(13, 23, 35), border_width=1, border_color=color.rgb(43, 58, 72))
if barstate.islast
    table.set_position(panel, panelPosition)
    table.clear(panel, 0, 0, 1, 11)
    if not hideOutside or radarHour
        color ink = color.rgb(226, 234, 241)
        color muted = color.rgb(147, 163, 184)
        table.cell(panel, 0, 0, "I-GOD KILLZONE RADAR", text_color=color.aqua)
        table.cell(panel, 1, 0, "H1 · SPOT", text_color=muted)
        bool showProb = MODEL_VALIDATED and lastDataOK and not na(lastUpper)
        // Display tenths sum to exactly 100.0: conservative truncation + residual.
        float upDisplay = showProb ? math.floor(lastUpper * 1000) / 10 : na
        float downDisplay = showProb ? math.floor(lastLower * 1000) / 10 : na
        table.cell(panel, 0, 1, "SUPERIOR PRIMERO", text_color=ink)
        table.cell(panel, 1, 1, showProb ? str.tostring(upDisplay, "#.0") + " %" : "—", text_color=color.lime)
        table.cell(panel, 0, 2, "INFERIOR PRIMERO", text_color=ink)
        table.cell(panel, 1, 2, showProb ? str.tostring(downDisplay, "#.0") + " %" : "—", text_color=color.red)
        table.cell(panel, 0, 3, "NINGUNO", text_color=ink)
        table.cell(panel, 1, 3, showProb ? str.tostring(100 - upDisplay - downDisplay, "#.0") + " %" : "—", text_color=muted)
        table.cell(panel, 0, 4, "Estado", text_color=muted)
        table.cell(panel, 1, 4, MODEL_STATUS, text_color=color.orange)
        table.cell(panel, 0, 5, "Datos", text_color=muted)
        table.cell(panel, 1, 5, not identityOK ? "SOLO BINANCE:BTCUSDT H1" : lastDataOK and radarHour ? "COMPLETOS A TIMESTAMP" : "INCOMPLETOS / FUERA DE HORA", text_color=ink)
        table.cell(panel, 0, 6, "Ultima informacion UTC", text_color=muted)
        table.cell(panel, 1, 6, na(lastAvailable) ? "SIN PREDICCION VALIDA" : str.format_time(lastAvailable, "yyyy-MM-dd HH:mm", "UTC"), text_color=ink)
        table.cell(panel, 0, 7, "Londres restante", text_color=muted)
        table.cell(panel, 1, 7, radarHour and not na(lastMinute) ? str.tostring(60-lastMinute) + " min a datos" : "CERRADO", text_color=ink)
        table.cell(panel, 0, 8, "Modelo", text_color=muted)
        table.cell(panel, 1, 8, MODEL_VERSION, text_color=ink)
        table.cell(panel, 0, 9, showProb ? "HIPOTESIS ESTADISTICA" : "SIN PROBABILIDADES VALIDADAS", text_color=color.orange)
        table.cell(panel, 0, 10, "SHADOW ONLY · NO ORDERS", text_color=muted)
        table.cell(panel, 0, 11, "TRADE AUTHORITY: NONE", text_color=muted)
